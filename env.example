# DeFi Arbitrage Dashboard - Environment Variables

# ========================================
# BLOCKCHAIN RPC URLs (Required for frontend)
# ========================================
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://eth-mainnet.alchemyapi.io/v2/demo
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-mainnet.alchemyapi.io/v2/demo
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org/

# ========================================
# API KEYS (Replace with your real keys)
# ========================================
ALCHEMY_API_KEY=your_alchemy_api_key_here
INFURA_API_KEY=your_infura_api_key_here

# ========================================
# WALLET CONFIGURATION (Only for testing - NEVER use in production)
# ========================================
# PRIVATE_KEY=your_private_key_for_testing_only
# WALLET_ADDRESS=your_wallet_address

# ========================================
# CONTRACT ADDRESSES (Default values provided)
# ========================================
AAVE_V3_POOL_ADDRESS=0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2
DYDX_SOLO_MARGIN_ADDRESS=0x1E0447b19BB6EcFdAe1e4AE1694b0C3659614e4e

# ========================================
# DEX ROUTER ADDRESSES (Default values provided)
# ========================================
UNISWAP_V2_ROUTER=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
SUSHISWAP_ROUTER=0xd9e1cE17f2641f24aE83637ab66a2cca9C378B9F
PANCAKESWAP_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E

# ========================================
# BOT CONFIGURATION
# ========================================
MIN_PROFIT_THRESHOLD=0.5
MAX_GAS_PRICE=50
SLIPPAGE_TOLERANCE=0.01
MONITORING_INTERVAL=10000

# ========================================
# SECURITY FLAGS
# ========================================
ENABLE_MAINNET=false
ENABLE_AUTO_EXECUTION=false

# ========================================
# FOR VERCEL DEPLOYMENT:
# ========================================
# 1. Copy ALL these variables to your Vercel dashboard
# 2. Replace demo/placeholder values with real API keys
# 3. Set ENABLE_MAINNET=true for production (optional)
# 4. NEVER set ENABLE_AUTO_EXECUTION=true unless you know what you're doing
# 5. NEVER add PRIVATE_KEY in production deployment
